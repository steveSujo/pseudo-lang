# psudo default project config

# Create this file as `psudo.toml` in your project root
# The interpreter auto-detects it by walking up from current directory

[sandbox]
# Sandbox root directory (relative to project root)
# Default: ".sandbox"
root = ".sandbox"

# Maximum file size in bytes
# Default: 1048576 (1MB)
max_file_size = 1048576

# Maximum total sandbox size in bytes
# Default: 10485760 (10MB)
max_sandbox_size = 10485760

# Allow reading files outside sandbox (config files, etc)
# Default: false
allow_external_read = false

# Allowed external read paths (relative to project root)
# Only used if allow_external_read = true
# Default: []
allowed_external_reads = []

# Deny list for external reads (security)
# Paths matching these prefixes are never allowed
# Default: system directories
deny_external_reads = [
    "/etc",
    "/root",
    "/home",
    "C:\\Windows",
    "C:\\Program Files",
    "C:\\Program Files (x86)",
    "C:\\Users\\*\\AppData",
]