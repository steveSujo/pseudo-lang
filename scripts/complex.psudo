print "=== Complex Expressions ===";

print (1 + 2) * (3 + 4);
print 10 - 2 * 3;
print (10 - 2) * 3;
print 100 / 2 / 5;
print 100 / (2 * 5);

let a = 2;
let b = 3;
let c = 4;
print a + b * c;
print (a + b) * c;
print a * (b + c);

print "--- Chained comparisons ---";
print 1 < 2 < 3;
print 10 > 5 > 1;

print "--- Unary with binary ---";
let x = 5;
print -x + 10;
print -(x + 10);

print "--- String with numbers ---";
print "result: " + (5 + 3);
print "value: " + 42;